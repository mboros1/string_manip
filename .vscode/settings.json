{
    "c-cpp-flylint.clang.standard": ["c17"],
    "c-cpp-flylint.standard": ["c17"],
    "testMate.cpp.test.executables": "{bin/test_*}",
    "testMate.cpp.log.logfile": "test-explorer.log",
    "testMate.cpp.discovery.runtimeLimit": 900,
    "testMate.cpp.test.workingDirectory": "${workspaceFolder}",
    "testMate.cpp.discovery.framework": "gtest",
    "testMate.cpp.discovery.extraFields": [
        {"name": "Test Suite", "regex": "^([^\\.]*)"}
    ],
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "{bin/test_*}",
            "cwd": "${workspaceFolder}",
            "env": {}
        }
    ],
    "testMate.cpp.log.logpanel": true,
    "testMate.cpp.test.runtimeLimit": 60000,
    
    // Custom make settings for local build
    "makefile.configurations": [
        {
            "name": "Default",
            "makeDirectory": "${workspaceFolder}",
            "makefilePath": "${workspaceFolder}/Makefile",
            "makePath": "make",
            "env": {
                "CC": "gcc-14",
                "SIMDE_INCLUDE": "${shell:brew --prefix simde}/include/"
            }
        }
    ],
    "makefile.defaultLaunchConfiguration": {
        "cwd": "${workspaceFolder}",
        "binaryPath": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
        "env": {}
    },
    "makefile.launchConfigurations": [
        {
            "cwd": "${workspaceFolder}",
            "binaryPath": "${workspaceFolder}/bin/test_faf_string",
            "env": {}
        }
    ]
}